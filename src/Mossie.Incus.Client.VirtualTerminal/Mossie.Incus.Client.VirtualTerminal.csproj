<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>Mossie.Incus.Client.VirtualTerminal</PackageId>
    <Version>7.6.0</Version>
    <Authors>Mossie</Authors>
    <Description>VirtualTerminal integration for Mossie.Incus.Client: an interactive terminal session over an Incus instance exec PTY.</Description>
    <PackageTags>incus;terminal;virtualterminal;vt;ansi;console</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/dmostert/Mossie.Incus.Client</RepositoryUrl>
    <PackageProjectUrl>https://github.com/dmostert/Mossie.Incus.Client</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Mossie.Incus.Client/Mossie.Incus.Client.csproj" />
    <PackageReference Include="VirtualTerminal" Version="1.12.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
